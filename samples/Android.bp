
filegroup {
    name: "samples_files",

    srcs: [
        "test-surface.cpp",
        "misc/triangle.cpp",
        "gles3jni/gles3jni.cpp",
        "gles3jni/RendererES2.cpp",
        "gles3jni/RendererES3.cpp",
    ],
}


cc_binary {
    name: "run-samples",
    srcs: [":samples_files"],
    shared_libs : [
        "libcutils",
        "libutils",
        "libui",
        "libgui",
        "libEGL",
        "libGLESv3",
        "libnativewindow",
        "liblog",
    ],

    local_include_dirs : [
        "misc",
        "gles3jni",
    ],
    cflags : [
        "-g3",
        "-O0",
    ],
}
