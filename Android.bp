
filegroup {
    name: "egl_core_files",

    srcs: [
        "egl/display.cpp",
        "egl/egl-surface.cpp",
        "egl/egl.cpp",
        "egl/libgbm.c",
    ],
}

cc_library_shared {
    name: "libEGL_proxy",
    defaults: ["opengl_defaults"],
    local_include_dirs : [
        "include",
        "util",
    ],
}

filegroup {
    name: "glesv1_core_files",

    srcs: [
        "glesv1/glesv1_cm.c",
    ],
}

cc_library_shared {
    name: "libGLESv1_CM_proxy",
    defaults: ["fde_hybris_defaults"],
    local_include_dirs : ["include"],

    relative_install_path: "egl",

    srcs: [":glesv1_core_files"],
}

filegroup {
    name: "glesv2_core_files",

    srcs: [
        "glesv2/glesv2.c",
    ],
}

cc_library_shared {
    name: "libGLESv2_proxy",
    defaults: ["fde_hybris_defaults"],
    local_include_dirs : ["include"],

    relative_install_path: "egl",

    srcs: [":glesv2_core_files"],
}


filegroup {
    name: "ugralloc_core_files",

    srcs: [
        "util/u_gralloc/u_gralloc.c",
        "util/u_gralloc/u_gralloc_fallback.c",
        "util/u_gralloc/u_gralloc_internal.c",
        "util/u_gralloc/u_gralloc_libdrm.c",
    ],
}

cc_library_static {
    name: "libhybris_utils",
    defaults: ["fde_hybris_defaults"],
    local_include_dirs : ["include"],

    srcs: [":ugralloc_core_files"],

    shared_libs: [
        "libcutils",
        "libnativewindow",
        "libhardware",
    ],

    cflags: [
        "-Wno-cast-qual",
        "-Wno-sign-compare",
        "-Wno-cast-align",
    ],

}

cc_defaults {
    name : "opengl_defaults",
    defaults: ["fde_hybris_defaults"],

    relative_install_path: "egl",

    srcs: [":egl_core_files"],

    header_libs: [
//        "gl_headers",
        "libsystem_headers",
        "libnativebase_headers",
    ],

    shared_libs: [
        "libcutils",
        "libnativewindow",
        "libhardware",
        "libGLESv2_proxy",
    ],

    static_libs: [
        "libarect",
        "libhybris_utils",
    ],

    // headers we include in our public headers
    export_static_lib_headers: [
        "libarect",
    ],
    export_shared_lib_headers: ["libnativewindow"],

}

cc_defaults {
    name: "fde_hybris_defaults",

    cflags: [
        "-D_GNU_SOURCE=1",
        "-D_FILE_OFFSET_BITS=64",
        "-Wall",
        "-Wsign-compare",
        "-Wpointer-arith",
        "-Wcast-qual",
        "-Wcast-align",
        "-Wno-unused-parameter",
    ],

    vendor: true,

    shared_libs: [
        "libsync",
        "liblog",
        "libdl",
    ],
}
